# ----------------------------------------------------------------------
# Required
# ----------------------------------------------------------------------
# Shared secret the site admin (and any internal caller) sends as
# X-Internal-Api-Key when reading or writing the CRM.
INTERNAL_API_KEY=

# Supabase: Project Settings -> Database -> Connection string (use the pooler
# for the API, the direct connection for migrations).
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
SYNC_DATABASE_URL=postgresql+psycopg2://postgres.<ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
REDIS_URL=redis://localhost:6379/0

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_DEPLOYMENT_CHAT=gpt-5-mini
AZURE_DEPLOYMENT_EMBEDDINGS=text-embedding-3-small

# ----------------------------------------------------------------------
# Agent identity
# ----------------------------------------------------------------------
SALES_AGENT_ENABLED=true
SALES_COMPANY_NAME=Optimatech
SALES_AGENT_DISPLAY_NAME=Nour
# Where handoff notifications go.
SALES_HANDOFF_NOTIFY_EMAIL=

# ----------------------------------------------------------------------
# Optimatech site integration
# ----------------------------------------------------------------------
# Public site origin — used to build /book, /checkout and pricing links.
SITE_BASE_URL=https://optimatech.example.com
# Where the site's /api/internal/* endpoints live (usually the same origin).
SITE_API_BASE_URL=https://optimatech.example.com
# Must match SALES_AGENT_INTERNAL_KEY on the site. Without it the agent shares a
# booking link instead of booking a real slot.
SITE_INTERNAL_API_KEY=

# ----------------------------------------------------------------------
# Meta platform
# ----------------------------------------------------------------------
# App secret from the Meta app dashboard. Webhooks are REJECTED without it.
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=ar

# Facebook Page / Messenger
MESSENGER_VERIFY_TOKEN=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_PAGE_ID=

# Approved template names. Leave empty until Meta has approved them: an
# unapproved name fails silently at send time.
SALES_LEAD_FORM_TEMPLATE_NAME=
SALES_REENGAGE_TEMPLATE_NAME=

# ----------------------------------------------------------------------
# Messaging policy
# ----------------------------------------------------------------------
SALES_SERVICE_WINDOW_HOURS=24
# Local quiet hours [start, end) for PROACTIVE messages only.
SALES_QUIET_HOURS_START=21
SALES_QUIET_HOURS_END=9
SALES_DEFAULT_TIMEZONE=Africa/Cairo
SALES_MAX_OUTBOUND_PER_LEAD_PER_DAY=1
SALES_MAX_OUTBOUND_PER_LEAD_TOTAL=5

# ----------------------------------------------------------------------
# Agent behaviour
# ----------------------------------------------------------------------
SALES_MAX_TOOL_ROUNDS=4
SALES_HISTORY_MESSAGES=12
SALES_KB_TOP_K=6
SALES_KB_MIN_SIMILARITY=0.20
SALES_UPSELL_COOLDOWN_DAYS=30
CROSS_SELL_MIN_DAYS_AFTER_DELIVERY=14

# ----------------------------------------------------------------------
# Workers
# ----------------------------------------------------------------------
OUTBOUND_TICK_SECONDS=300
SEQUENCE_TICK_SECONDS=900
