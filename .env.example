# ----------------------------------------------------------------------
# Required
# ----------------------------------------------------------------------
# Shared secret the LMS backend sends as X-Internal-Api-Key.
INTERNAL_API_KEY=

DATABASE_URL=postgresql+asyncpg://sales:sales@localhost:5432/sales_agent
SYNC_DATABASE_URL=postgresql+psycopg2://sales:sales@localhost:5432/sales_agent
REDIS_URL=redis://localhost:6379/0

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_DEPLOYMENT_CHAT=gpt-5-mini
AZURE_DEPLOYMENT_EMBEDDINGS=text-embedding-3-small

# ----------------------------------------------------------------------
# Agent identity
# ----------------------------------------------------------------------
SALES_AGENT_ENABLED=true
SALES_COMPANY_NAME=OptimaLearn
SALES_AGENT_DISPLAY_NAME=Nour
# Booking page the agent shares when a prospect wants a demo.
SALES_BOOKING_URL=
SALES_HANDOFF_NOTIFY_EMAIL=

# ----------------------------------------------------------------------
# LMS integration (live catalogue and pricing)
# ----------------------------------------------------------------------
# NestJS API root including the version prefix.
LMS_API_BASE_URL=https://your-lms-api.example.com/api/v1
# Must match SALES_INTERNAL_API_KEY on the LMS side.
LMS_INTERNAL_API_KEY=
# Public site root, used to build course/pricing/signup links.
SALES_WEB_BASE_URL=https://your-site.example.com

# ----------------------------------------------------------------------
# Meta platform
# ----------------------------------------------------------------------
# App secret from the Meta app dashboard. Webhooks are REJECTED without it.
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=ar

# Facebook Page / Messenger
MESSENGER_VERIFY_TOKEN=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_PAGE_ID=

# Approved template names. Leave empty until Meta has approved them: an
# unapproved name fails silently at send time.
SALES_LEAD_FORM_TEMPLATE_NAME=
SALES_REENGAGE_TEMPLATE_NAME=

# ----------------------------------------------------------------------
# Messaging policy
# ----------------------------------------------------------------------
SALES_SERVICE_WINDOW_HOURS=24
# Local quiet hours [start, end) for PROACTIVE messages only.
SALES_QUIET_HOURS_START=21
SALES_QUIET_HOURS_END=9
SALES_DEFAULT_TIMEZONE=Africa/Cairo
SALES_MAX_OUTBOUND_PER_LEAD_PER_DAY=1
SALES_MAX_OUTBOUND_PER_LEAD_TOTAL=5

# ----------------------------------------------------------------------
# Agent behaviour
# ----------------------------------------------------------------------
SALES_MAX_TOOL_ROUNDS=4
SALES_HISTORY_MESSAGES=12
SALES_KB_TOP_K=6
SALES_KB_MIN_SIMILARITY=0.20
SALES_UPSELL_COOLDOWN_DAYS=7
# Standing volume discounts as {min_seats: fraction}. Empty means list price.
SALES_VOLUME_DISCOUNT_BANDS={}

# ----------------------------------------------------------------------
# Workers
# ----------------------------------------------------------------------
OUTBOUND_TICK_SECONDS=300
SEQUENCE_TICK_SECONDS=900
